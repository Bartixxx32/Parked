    <string name="section_reliability_oem">Spolehlivost (ColorOS a další nadstavby)</string>
    <string name="reliability_oem_intro">Android může ukončit službu na pozadí a OnePlus/ColorOS používá vlastní úsporu energie. Postupujte podle těchto kroků:</string>
    <string name="reliability_steps">1. Nastavení → Baterie → Neomezeno\n2. Nastavení → Automatické spuštění → zapnout pro Parked\n3. Uzamkněte aplikaci v seznamu nedávných (visací zámek)\n4. Neomezujte aktivitu na pozadí v panelu ColorOS</string>
    <string name="open_battery_settings">Otevřít nastavení baterie</string>
    <string name="open_autostart_settings">Otevřít nastavení automatického spuštění</string>
