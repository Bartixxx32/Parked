    <string name="section_auto_save">Automatické ukládání</string>
    <string name="save_delay_title">Zpoždění po odpojení</string>
    <string name="save_delay_desc">Poloha se získá okamžitě při odpojení. Toto zpoždění pouze odkládá uložení, aby byl čas na opětovné připojení (které uložení zruší).</string>
    <string name="gps_timeout_title">Maximální doba čekání na GPS</string>
    <string name="gps_timeout_desc">Po uplynutí této doby aplikace použije poslední známou polohu (pokud je to povoleno).</string>
    <string name="max_accuracy_title">Maximální povolená přesnost</string>
    <string name="max_accuracy_desc">Méně přesná zaměření se odmítnou, aby se neuložil náhodný bod.</string>
    <string name="fallback_enabled_title">Nouzová poslední známá poloha</string>
    <string name="fallback_enabled_desc">Pokud není k dispozici nové zaměření GPS, uloží se poslední známý bod a označí se upozorněním.</string>
    <string name="fallback_age_title">Maximální stáří nouzového bodu</string>
    <string name="notifications_title">Oznámení</string>
    <string name="notifications_body">Parked neposílá oznámení o uložení ani o chybách. Jediné oznámení je oznámení služby sledování, které vyžaduje Android. Můžete jej vypnout v nastavení systému — sledování bude dál fungovat.</string>
    <string name="notification_settings">Nastavení oznámení</string>
    <string name="section_permissions">Oprávnění</string>
    <string name="permission_location">Poloha (přesná nebo přibližná)</string>
    <string name="permission_background_location">Poloha na pozadí (\"Povolit vždy\")</string>
    <string name="permission_background_detail">Nutné, když je telefon zamčený nebo aplikace běží na pozadí.</string>
    <string name="permission_bluetooth_on">Bluetooth zapnutý v systému</string>
    <string name="permission_battery_off">Optimalizace baterie vypnuta</string>
