    <string name="family_share_note_title">Laatste notitie delen</string>
    <string name="family_share_note_desc">De notitie bij je laatste plek wordt meegestuurd in de versleutelde update. Oudere notities en notities bij andere plekken blijven op deze telefoon.</string>
